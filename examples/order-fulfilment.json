{
  "schemaVersion": "1",
  "workflow": "order-fulfilment",
  "description": "A small, fully wired workflow: every input has a producer and every output is consumed or exported.",
  "provided": [
    { "name": "orderId", "type": "string", "description": "Supplied when the workflow is started." },
    { "name": "catalogue", "type": "Catalogue" }
  ],
  "exports": [
    { "name": "shipment", "type": "Shipment" },
    { "name": "notice", "type": "Notice" }
  ],
  "steps": [
    {
      "id": "fetch-order",
      "version": "2.1.0",
      "inputs": [{ "name": "orderId", "type": "string" }],
      "outputs": [{ "name": "order", "type": "Order" }]
    },
    {
      "id": "check-stock",
      "version": "1.4.2",
      "inputs": [
        { "name": "order", "type": "Order", "minVersion": "2.0.0" },
        { "name": "catalogue", "type": "Catalogue" }
      ],
      "outputs": [
        { "name": "reservation", "type": "Reservation" },
        {
          "name": "backorder",
          "type": "Backorder",
          "optional": true,
          "description": "Only emitted when stock is short."
        }
      ]
    },
    {
      "id": "price-order",
      "version": "3.0.1",
      "inputs": [{ "name": "order", "type": "Order", "minVersion": "2.1.0" }],
      "outputs": [{ "name": "invoice", "type": "Invoice" }]
    },
    {
      "id": "notify-backorder",
      "version": "1.0.0",
      "description": "Tolerates the absence of the optional backorder channel.",
      "inputs": [{ "name": "backorder", "type": "Backorder", "optional": true }],
      "outputs": [{ "name": "notice", "type": "Notice" }]
    },
    {
      "id": "ship",
      "version": "1.2.0",
      "requires": ["notify-backorder"],
      "inputs": [
        { "name": "reservation", "type": "Reservation" },
        { "name": "invoice", "type": "Invoice" }
      ],
      "outputs": [{ "name": "shipment", "type": "Shipment" }]
    }
  ]
}
